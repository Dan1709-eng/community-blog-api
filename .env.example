# Port the API listens on
PORT=3000

# development | production
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
# Local example:  mongodb://127.0.0.1:27017/community-blog
# Atlas example:  mongodb+srv://<username>:<password>@<cluster-host>/community-blog?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/community-blog

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a token stays valid (examples: 15m, 12h, 1d, 7d)
JWT_EXPIRES_IN=1d